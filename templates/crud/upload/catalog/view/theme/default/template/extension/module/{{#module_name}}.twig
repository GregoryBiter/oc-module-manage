<div class="panel panel-default module-{{#module_name}}">
  <div class="panel-heading">
    <h3 class="panel-title">{{ heading_title }}</h3>
  </div>
  <div class="panel-body">
    {% if items %}
    <div class="row">
      {% for item in items %}
      <div class="col-sm-6 col-md-4">
        <div class="thumbnail">
          <div class="caption">
            <h4>{{ item.title }}</h4>
            <div>{{ item.description }}</div>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p class="text-muted text-center">{{ text_no_results }}</p>
    {% endif %}
  </div>
</div>
