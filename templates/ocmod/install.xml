<?xml version="1.0" encoding="utf-8"?>
<modification>
    <name>{{#module_title}}</name>
    <code>{{#module_name}}</code>
    <version>{{#version}}</version>
    <author>{{#author}}</author>
    <link></link>

    <!-- 1. Модификация контроллера витрины -->
    <file path="catalog/controller/common/header.php">
        <operation>
            <search><![CDATA[$data['title'] = $this->document->getTitle();]]></search>
            <add position="after"><![CDATA[
            // [{{#module_name}}] Инъекция статуса в контроллер шапки
            $data['{{#module_name}}_status'] = $this->config->get('module_{{#module_name}}_status');
            ]]></add>
        </operation>
    </file>

    <!-- 2. Модификация шаблона витрины -->
    <file path="catalog/view/theme/*/template/common/header.twig">
        <operation>
            <search><![CDATA[</head>]]></search>
            <add position="before"><![CDATA[
            {% if {{#module_name}}_status %}
            <!-- {{#module_title}} Active -->
            {% endif %}
            ]]></add>
        </operation>
    </file>

    <!-- 3. Модификация панели управления (пример) -->
    <file path="admin/controller/common/header.php">
        <operation>
            <search><![CDATA[$data['title'] = $this->document->getTitle();]]></search>
            <add position="after"><![CDATA[
            // [{{#module_name}}] Хук панели управления
            ]]></add>
        </operation>
    </file>
</modification>
