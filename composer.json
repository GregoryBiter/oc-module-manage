{
    "name": "gregorybiter/oc-module-manage",
    "description": "OpenCart Module Management CLI (Artisan-like tool)",
    "type": "library",
    "license": "MIT",
    "bin": [
        "bin/ocm"
    ],
    "autoload": {
        "psr-4": {
            "Ocm\\": "php_module/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=7.4",
        "symfony/console": "^5.4 || ^6.0 || ^7.0",
        "ext-json": "*",
        "ext-zip": "*"
    },
    "suggest": {
        "ext-dom": "Needed for strict XML validation of install.xml"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "scripts": {
        "test": "php tests/standalone_runner.php"
    }
}
