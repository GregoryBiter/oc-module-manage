#!/bin/bash

# OCM CLI Wrapper (Backward compatibility)
SCRIPT_DIR=$(dirname "$(readlink -f "$0")")

if [ -x "$SCRIPT_DIR/bin/ocm" ]; then
    exec "$SCRIPT_DIR/bin/ocm" "$@"
elif [ -f "$SCRIPT_DIR/bin/ocm" ]; then
    exec php "$SCRIPT_DIR/bin/ocm" "$@"
elif [ -f "$SCRIPT_DIR/oc-module.php" ]; then
    exec php "$SCRIPT_DIR/oc-module.php" "$@"
else
    echo "Error: OCM executable not found in $SCRIPT_DIR."
    exit 1
fi
