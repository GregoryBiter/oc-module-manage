{
    "name": "gregorybiter/ocm-cli",
    "description": "Autonomous Artisan-like developer toolkit & CLI for OpenCart modules and extensions",
    "keywords": [
        "opencart",
        "ocm",
        "artisan",
        "cli",
        "ocmod",
        "module-manager",
        "developer-tools"
    ],
    "type": "library",
    "license": "MIT",
    "bin": [
        "bin/ocm"
    ],
    "autoload": {
        "psr-4": {
            "Ocm\\": "php_module/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=7.4",
        "symfony/console": "^5.4 || ^6.0 || ^7.0",
        "ext-json": "*",
        "ext-zip": "*"
    },
    "suggest": {
        "ext-dom": "Needed for strict XML validation of install.xml"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "scripts": {
        "test": "php tests/standalone_runner.php"
    }
}
